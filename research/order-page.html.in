<!doctype html><html lang="he" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Casa Luma · Buying Studio</title><style>__CSS__</style></head><body>
<header class="shop-header"><a href="#catalog" class="brand"><img src="__LOGO__" alt="Casa Luma"><span>CASA LUMA<small>BUYING STUDIO</small></span></a><div class="header-actions"><span id="sync-status" class="sync-status" hidden></span><button id="team-button" hidden>הצוות</button><button id="logout" hidden>יציאה</button><select id="language" aria-label="Language / שפה"><option value="he">עברית</option><option value="en">English</option></select><button class="cart-link primary" data-view="cart" id="cart-link">סל הקניות · 0</button></div></header>
<nav class="shop-nav" id="main-nav"><button data-view="catalog" id="nav-catalog">מוצרים</button><button data-view="cart" id="nav-cart">סל הקניות</button><button data-view="history" id="nav-history">ההזמנות שלנו</button><button data-view="suppliers" id="nav-suppliers">ספקים</button><div class="nav-tools"><button id="backup">גיבוי</button><label class="button"><span id="import-label">טעינה</span><input type="file" id="import" accept=".json,application/json" hidden></label><button id="employee-export">דף לעובד</button></div></nav>
<main><div class="warning sync-alert" id="sync-alert" hidden><p id="sync-error"></p><button id="sync-backup">גיבוי העריכה שלי</button><button id="sync-reload">טעינת הגרסה המשותפת</button><button id="sync-retry">ניסיון שמירה נוסף</button></div><div id="storage-warning" class="warning" hidden></div><div id="app-startup" class="notice">הקטלוג לקריאה מוצג למטה. כלי הסל וההזמנות דורש JavaScript בדפדפן.</div><noscript><p class="warning">JavaScript נדרש לעריכת מחירים, סל והזמנות.</p></noscript>
<section id="catalog-view"><div class="section-heading"><div><p class="eyebrow">YOUR NEXT COLLECTION</p><h1 id="catalog-title">בוחרים את החנות שלכם.</h1><p id="catalog-subtitle">המחיר שלך, הדגם שלך, הכמות שלך — ואז לסל.</p></div><div class="count-label" id="catalog-count">__PRODUCT_COUNT__ מוצרים</div></div>
<div class="shop-filters"><input id="search" type="search" placeholder="חיפוש מוצר או מותג"><select id="category" aria-label="Category"></select><select id="brand-filter" aria-label="Brand"></select><select id="budget-filter" aria-label="Budget"></select><select id="price-filter" aria-label="Promotion"></select><select id="platform-filter" aria-label="Source"></select><select id="stock-filter" aria-label="Stock"></select><select id="sort-order" aria-label="Sort"></select><label class="check"><input type="checkbox" id="show-hidden"><span id="hidden-label"></span></label></div>
<p class="catalog-notice" id="research-notice"></p><div class="catalog-grid" id="catalog-grid">__STATIC_CARDS__</div><p id="catalog-empty" class="empty" hidden></p></section>
<section id="cart-view" hidden><div class="section-heading"><div><p class="eyebrow">YOUR BUYING CART</p><h1 id="cart-title"></h1><p id="cart-subtitle"></p></div><button data-view="catalog" id="continue-shopping"></button></div><div class="cart-layout"><div><div class="cart-toolbar"><label class="check"><input type="checkbox" id="select-all"><span id="select-all-label"></span></label><select id="cart-group" aria-label="Group cart"></select><select id="cart-filter" aria-label="Filter cart"></select><select id="cart-sort" aria-label="Sort cart"></select><button id="cart-csv">CSV</button></div><div id="cart-items"></div></div><aside class="checkout-panel"><h2 id="checkout-title"></h2><div id="cart-totals"></div><p id="cart-problems" class="warning" hidden></p><button class="primary large" id="checkout"></button><button class="large" id="request-quote"></button><p class="muted" id="checkout-help"></p><details class="delivery-panel" open><summary id="delivery-title"></summary><div id="delivery-fields"></div></details></aside></div></section>
<section id="history-view" hidden><div class="section-heading"><div><p class="eyebrow">PURCHASE ORDERS</p><h1 id="history-title"></h1><p id="history-help"></p></div><div><select id="message-language" aria-label="Supplier message language"><option value="en">English</option><option value="th">ภาษาไทย</option></select><button id="export-orders"></button></div></div><div class="history-toolbar"><input id="order-search" type="search"><select id="order-status" aria-label="Order status"></select><select id="order-supplier" aria-label="Order supplier"></select><select id="order-channel" aria-label="Order channel"></select><select id="order-category" aria-label="Order category"></select><select id="order-sort" aria-label="Order sort"></select></div><div id="order-history"></div></section>
